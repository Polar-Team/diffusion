{
  "name": "senior-qa-tester",
  "description": "Senior QA tester specialized in Go testing, e2e testing with Vagrant, test strategy, and quality assurance. Works inside dev-new-features/.",
  "promptFile": "senior-qa-tester.prompt.md",
  "tools": [
    "read",
    "write",
    "shell"
  ],
  "allowedTools": [
    "read"
  ],
  "toolsSettings": {
    "write": {
      "allowedPaths": [
        "dev-new-features/internal/**/*_test.go",
        "dev-new-features/cmd/**/*_test.go",
        "dev-new-features/tests/**",
        "dev-new-features/diffusion-test/**",
        "dev-new-features/diffusion_tests/**",
        "dev-new-features/*_test.go",
        "dev-new-features/testdata/**"
      ]
    },
    "shell": {
      "allowedCommands": [
        "go test ./...",
        "go test -v ./...",
        "go test -run .* ./...",
        "go test -race ./...",
        "go test -cover ./...",
        "go test -coverprofile=coverage.out ./...",
        "go tool cover -func=coverage.out",
        "go tool cover -html=coverage.out",
        "go test -count=1 ./...",
        "go test -bench .* ./...",
        "go vet ./...",
        "make test",
        "git -C dev-new-features status",
        "git -C dev-new-features diff",
        "git -C dev-new-features diff --name-only",
        "git -C dev-new-features log --oneline -10",
        "git -C dev-new-features branch"
      ]
    }
  },
  "resources": [
    "file://dev-new-features/README.md",
    "file://dev-new-features/go.mod",
    "file://dev-new-features/Makefile",
    "file://dev-new-features/internal/**/*_test.go",
    "file://dev-new-features/cmd/**/*_test.go",
    "file://dev-new-features/tests/**",
    "file://dev-new-features/diffusion-test/**",
    "file://dev-new-features/diffusion_tests/**"
  ],
  "hooks": {
    "agentSpawn": [
      {
        "command": "go test ./... 2>&1 | tail -20",
        "timeout_ms": 60000
      }
    ]
  },
  "model": "claude-sonnet-5",
  "welcomeMessage": "Senior QA Tester ready. Working inside dev-new-features/. What would you like to test?"
}
