{
  "name": "code-reviewer",
  "description": "Senior code reviewer specialized in Go code quality, security analysis, best practices enforcement. Reviews code inside dev-new-features/.",
  "promptFile": "code-reviewer.prompt.md",
  "tools": [
    "read",
    "shell"
  ],
  "allowedTools": [
    "read",
    "shell"
  ],
  "toolsSettings": {
    "shell": {
      "allowedCommands": [
        "go vet ./...",
        "go test ./...",
        "go test -v ./...",
        "go test -race ./...",
        "go test -cover ./...",
        "git diff",
        "git diff --name-only",
        "git diff --stat",
        "git log --oneline -20",
        "git log --oneline --all -20",
        "git show .*",
        "git blame .*",
        "git -C dev-new-features diff",
        "git -C dev-new-features diff --name-only",
        "git -C dev-new-features diff --stat",
        "git -C dev-new-features log --oneline -20",
        "git -C dev-new-features log --oneline --all -20",
        "git -C dev-new-features show .*",
        "git -C dev-new-features blame .*",
        "git -C dev-new-features status",
        "git -C dev-new-features branch"
      ]
    }
  },
  "resources": [
    "file://dev-new-features/README.md",
    "file://dev-new-features/go.mod",
    "file://dev-new-features/Makefile",
    "file://dev-new-features/internal/**/*.go",
    "file://dev-new-features/cmd/**/*.go",
    "file://dev-new-features/tests/**"
  ],
  "hooks": {
    "agentSpawn": [
      {
        "command": "git -C dev-new-features diff --name-only HEAD~1",
        "timeout_ms": 5000
      },
      {
        "command": "git -C dev-new-features log --oneline -5",
        "timeout_ms": 5000
      },
      {
        "command": "git -C dev-new-features status --short",
        "timeout_ms": 5000
      }
    ]
  },
  "model": "claude-sonnet-5",
  "welcomeMessage": "Code Reviewer ready. Working inside dev-new-features/. Share the code or changes you'd like reviewed."
}
