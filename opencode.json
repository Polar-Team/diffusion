{
  "default_agent": "team-lead",
  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  },
  "mcp": {
    "diffusion": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "--rm",
        "-i",
        "-v",
        "/var/run/docker.sock:/var/run/docker.sock",
        "-v",
        "./:/project",
        "ghcr.io/polar-team/diffusion-mcp-server:latest"
      ],
      "enabled": true
    }
  },
  "permission": {
    "diffusion*": "deny"
  },
  "agent": {
    "team-lead": {
      "permission": {
        "diffusion*": "allow"
      }
    }
  }
}
